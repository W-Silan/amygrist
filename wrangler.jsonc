{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amy-grist",
  "compatibility_date": "2026-09-26",
  "pages_build_output_dir": "./dist",
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "310afa4b7ee71a6444a245450e7a9065",
    "FORM_RECIPIENT": "amygrist@gmail.com",
    "TURNSTILE_HOSTNAMES": "amygrist.com,www.amygrist.com,amy-grist.pages.dev,localhost,127.0.0.1"
  },
  "ratelimits": [
    {
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "2026093002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
