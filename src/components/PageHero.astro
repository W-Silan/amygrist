---
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';

interface Props {
  image: ImageMetadata;
  title: string;
  caption?: string;
  alt: string;
  position?: string;
  actions?: {label:string; href:string}[];
}

const {image, title, caption, alt, position = 'center', actions = []} = Astro.props;
---
<section class="page-hero" style={`--position:${position}`}>
 <Image src={image} alt={alt} widths={[480,768,1024,1500]} sizes="100vw" format="webp" loading="eager" fetchpriority="high"/>
 <div class="caption"><h1>{title}</h1>{caption && <p><span>{caption}</span></p>}{actions.length > 0 && <div class="actions">{actions.map(action => <a class="button" href={action.href}>{action.label}</a>)}</div>}</div>
</section>
<style>
.page-hero{height:40.6vw;max-height:800px;min-height:450px;position:relative;background:var(--teal);color:white}.page-hero img{width:100%;height:100%;object-fit:cover;object-position:var(--position)}.caption{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:100px 6% 0}.caption h1{font-size:60px;margin:0 0 20px;background:#023c4dcc;padding:10px 18px;border-radius:15px}.caption p{font-size:20px}.caption span{background:#023c4dcc;padding:6px 10px;border-radius:10px}.actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:14px}.actions .button{background:var(--rose-surface)}.actions .button:hover{background:var(--teal)}
@media(max-width:999px){.page-hero{height:450px;min-height:0}.caption{padding-top:70px}.caption h1{font-size:35px}.caption p{font-size:15px}}
</style>
