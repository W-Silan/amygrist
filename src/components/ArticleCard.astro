---
import {Image} from 'astro:assets';
import type {ArticleRecord} from '../data/articles';
import {getCategoryForName} from '../data/categories';

interface Props {article: Omit<ArticleRecord, 'featuredImage'> & {featuredImage: import('astro').ImageMetadata}}
const {article} = Astro.props;
---
<article class="article-card">
  <a class="article-card__image" href={article.path} tabindex="-1" aria-hidden="true">
    <Image src={article.featuredImage} alt="" widths={[420, 720, 960]} sizes="(max-width: 720px) 88vw, (max-width: 1100px) 44vw, 30vw" format="webp" loading="lazy" />
  </a>
  <div class="article-card__content">
    {article.categories.length > 0 && <p class="article-card__category">{article.categories.map((name, index) => {const category = getCategoryForName(name); return <>{index > 0 && ' · '}{category ? <a href={category.path}>{name}</a> : name}</>;})}</p>}
    <p class="article-card__meta"><time datetime={article.datePublished}>{article.displayDate}</time><span aria-hidden="true"> · </span>{article.readingTime}</p>
    <h2><a href={article.path}>{article.title}</a></h2>
    <p class="article-card__summary">{article.excerpt}</p>
    <a class="article-card__link" href={article.path}>Read article <span aria-hidden="true">→</span></a>
  </div>
</article>
<style>
.article-card{overflow:hidden;background:#fff;border:1px solid #a84f5c26;border-radius:8px;box-shadow:0 12px 30px #023c4d0d;display:flex;flex-direction:column}.article-card__image{display:block;aspect-ratio:1.65;overflow:hidden;background:var(--soft-rose)}.article-card__image img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}.article-card__image:hover img{transform:scale(1.025)}.article-card__content{padding:24px;display:flex;flex-direction:column;align-items:flex-start;flex:1}.article-card__category{margin:0 0 9px;color:var(--teal);font:400 13px/1.4 var(--nav);text-transform:uppercase;letter-spacing:.06em}.article-card__category a{color:inherit;text-decoration:none}.article-card__meta{font-size:13px;margin:0 0 12px;color:var(--ink)}.article-card h2{font-size:27px;margin:0 0 12px}.article-card h2 a{color:var(--ink)}.article-card__summary{font-size:15px;line-height:1.6;margin:0 0 20px}.article-card__link{margin-top:auto;color:var(--link);font-weight:500}
@media(max-width:700px){.article-card__content{padding:20px}.article-card h2{font-size:24px}}
@media(prefers-reduced-motion:reduce){.article-card__image img{transition:none}}
</style>
