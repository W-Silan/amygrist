---
import home from '../data/home.json';
const testimonials=home[6].testimonials;
---
<section class="band testimonials center" aria-label="Workshop participant experiences"><div class="container"><h3>Workshop Participant's experiences</h3><hr class="rule short"/>
 <div class="quotes">{testimonials.map((t,i)=><figure hidden={i!==0}><blockquote>{t.quote}</blockquote><figcaption><strong>{t.name}</strong><br/><small>{t.subtitle}</small></figcaption></figure>)}</div>
 <div class="controls"><button data-direction="-1" aria-label="Previous testimonial">‹</button><span aria-live="polite">1 / 3</span><button data-direction="1" aria-label="Next testimonial">›</button></div>
</div></section>
<script>
const section=document.querySelector('.testimonials');if(section){let index=0;const figures=Array.from(section.querySelectorAll('figure'));section.querySelectorAll<HTMLButtonElement>('button').forEach(button=>button.addEventListener('click',()=>{index=(index+Number(button.dataset.direction)+figures.length)%figures.length;figures.forEach((figure,i)=>figure.hidden=i!==index);section.querySelector('[aria-live]')!.textContent=`${index+1} / ${figures.length}`;}));}
</script>
<style>.quotes{max-width:800px;margin:auto;min-height:310px}.quotes figure{margin:25px 0}.quotes blockquote{font-size:22px;line-height:1.4}figcaption{margin-top:24px;font-size:16px}small{font-size:12px}.controls{display:flex;align-items:center;justify-content:center;gap:25px}.controls button{color:var(--text-rose);border:0;background:none;width:44px;height:44px;font-size:28px}@media(max-width:600px){.quotes{min-height:0}.quotes blockquote{font-size:20px}}</style>
