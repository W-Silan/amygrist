---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import {images} from '../data/images';
import {href} from '../data/site';

const supports = ['emotional, mental, physical and spiritual balancing','restoring and expanding your life force energy','deep relaxation and nervous system regulation','alignment with your Higher Self and inner wisdom','strengthening the body’s natural healing processes','supporting ongoing medical or therapeutic treatments','boosting immunity and energetic vitality','healing for yourself, loved ones and even animals','connection, compassion and inner peace'];
const innerChildBenefits = ['soothe emotional wounds','restore balance to forgotten or hidden parts','clear imbalances from memories and past experiences','cultivate compassion, safety and acceptance','strengthen the relationship between the inner parent and inner child'];
const faqs = [
  ['What happens during a Reiki session?','In a Reiki session, you simply relax and receive. I channel universal life energy to support balance in your emotional, mental, physical and spiritual system. You may feel warmth, tingling, calm, emotion release, or simply deep rest; each experience is unique and perfect for your needs.'],
  ['Is Reiki safe?','Yes. Reiki is a gentle, non-invasive healing modality rooted in unconditional love. It is safe for all ages, supportive alongside medical treatment, and deeply beneficial for emotional, physical and spiritual wellbeing.'],
  ['What is distance Reiki and how does it work?','Distance Reiki allows healing energy to be sent across any distance using the traditional Reiki symbols. Energy is not limited by time or space, making distance sessions just as effective as in-person sessions. All I need is a name, location and optional photo.'],
  ['Do I need experience to learn Reiki?','No experience is needed. Reiki Level 1 is suitable for complete beginners. You’ll receive attunements, guided practice, and the tools needed to begin working with Reiki for yourself, loved ones and your environment.'],
  ['What is Inner Child Reiki?','Inner Child Reiki is a unique adaptation of Reiki 1 that incorporates direct work with your Inner Child. You’ll learn how to offer Reiki to your inner child, bring healing into memories, and strengthen your inner parent–child connection. This course is available one-to-one for those who have completed the Inner Child Workshop.'],
  ['Can Reiki be sent to pets or animals?','Yes. Reiki is deeply supportive for animals and can be offered through distance healing. It is gentle, safe and often very calming for pets.'],
  ['How long is a distance Reiki session?','A distance session is typically arranged within a specific time window. The process usually takes about a week from initial contact to the scheduled session. You are welcome to rest or meditate during the session, though it is not required.'],
  ['How do I book a session or course?','You can enquire directly using the link below. I will guide you through the next steps, discuss your needs, and arrange a healing or training time that works for you.'],
];
---

<BaseLayout title="Reiki Intuitive Healing | Holistic Therapy | Amy Grist" description="Reiki healing and Reiki training with Amy — intuitive Tibetan Reiki, distance healing and Inner Child Reiki to restore balance, clarity and energetic wellbeing." ogImage={images[483]}>
  <PageHero image={images[483]} title="Reiki" caption="A gentle return to balance, wholeness and universal life energy" alt="Hands channelling Reiki healing energy" />

  <article class="reiki-page">
    <section class="band"><div class="container copy stack">
      <section><h2>Tibetan Reiki: An Ancient Healing Practice</h2><hr class="rule short"/><p>Reiki is an ancient healing system founded by Dr. Mikao Usui. In Japanese, <em>Rei</em> translates to “Universal Spirit” or “Essence,” and <em>Ki</em> means “Life Energy” — also known as Chi in Eastern traditions. Together, Rei-ki expresses the universal life force energy that surrounds us, moves through us, and is woven into all of existence.</p><p>Reiki comes from a traditional Tibetan Buddhist lineage, once passed down orally from master to student and now shared through attunements, teachings and dedicated practice.</p><p>Although many modern variations exist, the essence of Reiki remains unchanged: when we open to the flow of universal life energy, healing becomes accessible on every level of our being.</p><p>Reiki is not tied to religion; it is a universal, inclusive practice that harmonises beautifully with any spiritual or holistic path.</p></section>

      <section><h2>How Reiki Supports You</h2><hr class="rule short"/><p>Reiki meets you exactly where you are. Because the universal life force is unconditional love, Reiki is entirely safe to receive and requires only your willingness to rest, soften and trust the process.</p><p>In the pace and pressure of modern living, many of us experience imbalance; emotionally, mentally, physically and spiritually. Reiki gently supports the natural intelligence of the body by bringing coherence, balance and ease to your energy system.</p><p>The more Reiki is practised and received, the more deeply your system integrates harmony and self-healing. The effects may be subtle or profound; both are equally valid, both are healing.</p><h3>Reiki can support:</h3><ul>{supports.map(item=><li>{item}</li>)}</ul><p>Reiki practitioners have been attuned and trained to channel this energy through sacred symbols and lineage teachings.</p><p class="center"><a class="button" href="#iccontact">Enquire about Reiki</a></p></section>

      <section><h2>Reiki with Me</h2><hr class="rule short"/><p>I offer Reiki Level 1 and Level 2 courses, following the Usui natural healing method. These courses are available online via Zoom and provide the foundational understanding, attunements and practices needed to begin or deepen your Reiki journey.</p><p>I also gladly offer distance Reiki healing. If you would like to receive Reiki, or request Reiki for a loved one, friend or pet, I would be honoured to support you.</p><p>Distance Reiki sessions can be arranged:</p><ul><li>at a specific time, or within an agreed timeframe</li><li>with just a full name, location and optional photograph</li><li>for adults, children and animals</li></ul><p>The process typically takes about a week from first contact to the scheduled session.</p></section>

      <section><h2>Inner Child Reiki (Reiki Level 1)</h2><hr class="rule short"/><h3>A unique, integrated path for Inner Child healing</h3><p>Inner Child Reiki is a special adaptation of the traditional Reiki 1 course, weaving in practices that support you in giving and receiving Reiki directly with your Inner Child. This course is offered one-to-one and exclusively for those who have completed the <a href="/inner-child/">Inner Council Inner Child Workshop</a>.</p><h3>What Is Inner Child Reiki?</h3><p>When we turn inward, the healing potential of Reiki awakens. It enhances intuition, emotional clarity and personal empowerment while supporting harmony across the energy system.</p><p>Your Inner Child is pure love; open, intuitive, joyful and deeply aligned with Reiki’s purpose of restoring balance within. Both practices recognise healing as a return to wholeness.</p><p>As Reiki Channels, we can direct loving energy toward our Inner Child to:</p><ul>{innerChildBenefits.map(item=><li>{item}</li>)}</ul><p>Building trust with your Inner Child is foundational to this work. Through consistent, loving presence, your inner child experiences being truly seen, held and valued.</p><p>When we trust the Reiki process, we trust that healing unfolds in the way that serves our highest good. In this union, Reiki and Inner Child Work become deeply intertwined, expanding inner trust, reconnecting us to Spirit, and restoring the wholeness that is already within us.</p><h3>Time & Costs</h3><p>Inner Child Reiki Level 1 includes:</p><ul><li>two sessions (120–150 minutes each), approx. 5 hours total</li><li>Reiki 1 certification</li></ul><p>Cost: <strong>£250 / $340 USD / $470 CAD</strong></p></section>
    </div></section>

    <section class="band invitation center"><div class="container"><h2>Begin Your Reiki Healing Journey</h2><hr class="rule short"/><p>If you feel called to experience balance, clarity and loving universal energy, I warmly invite you to connect.<br/>Whether you wish to receive Reiki, explore distance healing, or begin Reiki Level 1 or 2 training, I’m here to support and guide you gently.</p></div></section>

    <section class="band enquiry center" id="iccontact"><div class="container"><h2>Enquire about Reiki</h2><hr class="rule short"/><a class="button" href={href('/contact/')}>Get in touch</a></div></section>

    <section class="band rose faq"><div class="container"><h2>Reiki FAQ (Frequently Asked Questions)</h2><h3>A gentle, helpful section for clarity and reassurance</h3><hr class="rule short"/><dl>
      {faqs.slice(0,4).map(([q,a])=><><dt>{q}</dt><dd>{a}</dd></>)}
      <dt>What’s the difference between Reiki Level 1 and Level 2?</dt><dd><ul><li><strong>Reiki Level 1</strong> focuses on self-healing and learning to channel Reiki through touch.</li><li><strong>Reiki Level 2</strong> deepens your practice, introducing sacred symbols, distance healing, and the ability to work with others.</li></ul><p>You are welcome to enquire about which level is right for you.</p></dd>
      {faqs.slice(4).map(([q,a])=><><dt>{q}</dt><dd>{a}</dd></>)}
      </dl><p class="center"><a class="button" href="#iccontact">Enquire About Reiki</a></p></div></section>
  </article>
</BaseLayout>

<style>
  .stack{display:grid;gap:48px}.stack h2,.invitation h2,.enquiry h2,.faq h2{font-size:32px}.stack h3{font-size:24px;margin-top:30px}.stack .rule{margin:13px 0 24px}.stack a{text-decoration:underline;text-underline-offset:3px}.invitation{padding-bottom:25px}.invitation .rule,.enquiry .rule{margin-inline:auto}.invitation p{max-width:950px;margin-inline:auto}.enquiry{background:#f1dddd}.form-note{font-size:13px;color:var(--ink);margin-top:18px}.faq h3{font-size:23px}.faq .rule{border-color:var(--accent)}.faq dl{margin:0}.faq dt{font:400 22px var(--heading);margin-top:26px}.faq dt:first-child{margin-top:0}.faq dd{margin:5px 0 0}.faq .center{margin-top:36px}
  @media(max-width:799px){.stack h2,.invitation h2,.enquiry h2,.faq h2{font-size:28px}.stack h3,.faq h3{font-size:22px}.copy p{text-align:left}.faq dt{font-size:20px}}
</style>
