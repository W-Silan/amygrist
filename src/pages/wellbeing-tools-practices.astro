---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import {images} from '../data/images';
import sourceContent from '../data/wellbeing-tools-practices.html?raw';
---
<BaseLayout title="Wellbeing Tools & Practices | Amy Grist" description="Explore mindful, emotional, spiritual and inner child practices to support healing, balance and everyday resilience." ogImage={images[1866]}>
<PageHero image={images[1866]} title="Wellbeing Tools & Practices" caption="Gentle practices for everyday balance" alt="Wellbeing Tools and Practices page header" position="center" actions={[{label:'Explore the practices',href:'#emotional'},{label:'Support for your journey',href:'#support'}]}/>
<article class="wellbeing-page"><section class="band intro"><div class="container"><p class="intro-lead">Explore wellbeing tools with mindful, emotional, spiritual and inner child practices to support healing, balance and everyday resilience.</p><p>Wellbeing is an ongoing relationship with yourself; one built through awareness, compassion and gentle practices that support your whole being. This page gathers tools you can use every day to nurture emotional, mental, physical and spiritual balance. Begin wherever you feel called.</p><nav aria-label="On this page"><a href="#emotional">Emotional wellbeing</a><a href="#inner-child">Inner child</a><a href="#mindfulness">Mindfulness</a><a href="#shadow-work">Shadow work</a><a href="#spiritual">Spiritual practices</a><a href="#somatic">Somatic & creative</a></nav></div></section><section class="band body-band"><div class="container source-copy" set:html={sourceContent}></div></section></article>
</BaseLayout>
<style>
.intro{padding-top:55px;padding-bottom:35px}.intro .container{max-width:970px}.intro p{text-align:left}.intro-lead{font-size:20px;color:var(--ink)}.intro nav{display:flex;flex-wrap:wrap;gap:9px;margin-top:26px}.intro nav a{border:1px solid #bc5f6a55;border-radius:99px;padding:8px 14px;background:white;font-size:13px;white-space:nowrap}.body-band{padding-top:25px}.source-copy{max-width:1050px}.source-copy h2,.source-copy h3{color:var(--ink);scroll-margin-top:110px}.source-copy h2{font-size:34px;margin:52px 0 18px;border-top:1px solid #bc5f6a44;padding-top:28px}.source-copy h3{font-size:29px;margin:42px 0 14px}.source-copy h4{font-size:22px;margin:26px 0 10px;color:var(--ink)}.source-copy p,.source-copy li{text-align:left}.source-copy ul,.source-copy ol{margin-bottom:22px}.source-copy li{padding:3px 0}.source-copy .source-cta{display:table;margin:10px 0 20px;padding:10px 16px;background:var(--button);color:#fff;border-radius:var(--radius);font-size:14px}.source-copy .source-cta:hover{background:var(--teal);text-decoration:none}
@media(max-width:760px){.source-copy h2{font-size:29px;margin-top:40px}.source-copy h3{font-size:26px}.source-copy h4{font-size:21px}.intro nav{flex-wrap:nowrap;overflow:auto;padding-bottom:12px}.intro nav a{white-space:nowrap}}
</style>
