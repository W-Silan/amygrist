---
import BaseLayout from '../layouts/BaseLayout.astro';
import sourceContent from '../data/inner-child-resources.html?raw';
---
<BaseLayout title="Inner Child Resources | Amy Grist" description="A free, trauma-informed guide to helping your inner child feel safe through compassionate boundaries, nervous system awareness and gentle self-support." solidHeader={true}>
<article class="resource-page">
<header class="resource-hero"><div class="container"><p class="eyebrow">Free guide · Inner Child Resources</p><h1 class="title-underline title-underline--center title-underline--on-dark">Helping Your Inner Child Feel Safe</h1><p class="subtitle">A Trauma-Informed Boundaries Guide</p><a class="button" href="#guide">Explore the guide <span aria-hidden="true">↓</span></a></div><span class="orbit" aria-hidden="true"></span></header>
<section class="band"><div class="container resource-content"><div class="source-copy copy" set:html={sourceContent}></div><section class="download" id="guide"><p class="eyebrow">A free resource</p><h2 class="title-underline title-underline--center title-underline--on-blush">Receive the guide</h2><p>You’re invited to receive <em>Helping Your Inner Child Feel Safe: A Trauma-Informed Boundaries Guide</em> as a free resource.</p><a class="button" href="/download/1902/">Download the guide <span aria-hidden="true">↓</span></a><p class="file-note">PDF · Free to download</p></section><p class="mail-note">Newsletter signup isn’t connected in this preview while the provider choice remains open.</p><p class="further">For further supportive practices, exercises and mindful techniques to nurture emotional balance, inner connection and holistic wellbeing, explore <a href="/wellbeing-tools-practices/">Wellbeing Tools and Practices</a>.</p></div></section></article>
</BaseLayout>
<style>
.resource-page :is(h1,h2,h3,h4,p,li,a,em,strong){animation:none!important;opacity:1!important;transform:none!important}.resource-hero{position:relative;overflow:hidden;isolation:isolate;min-height:460px;display:grid;place-items:center;background:linear-gradient(115deg,#034b61,#0d6570 70%,#398b83);color:white;text-align:center;padding:145px 0 70px}.resource-hero .container{max-width:850px;position:relative;z-index:1}.eyebrow{font:400 13px/1.4 var(--nav);letter-spacing:.15em;text-transform:uppercase;color:#f1c1bb;margin:0 0 18px}.resource-hero h1{font-size:clamp(38px,6vw,66px);line-height:1.05;margin-bottom:14px}.subtitle{font:400 clamp(22px,3vw,32px)/1.25 var(--heading);color:#f1c1bb;margin-bottom:28px}.orbit{position:absolute;width:360px;height:360px;border:1px solid #ffffff28;border-radius:50%;right:-140px;bottom:-220px;z-index:0}.orbit:before,.orbit:after{content:'';position:absolute;inset:30px;border:1px solid #ffffff25;border-radius:50%}.orbit:after{inset:65px}.resource-content{max-width:920px}.source-copy h2{font-size:30px;margin-top:38px}.source-copy p,.source-copy li{text-align:left}.source-copy ul{margin-bottom:24px}.download{margin-top:42px;padding:clamp(28px,5vw,54px);background:#f0dddd;border:1px solid #bc5f6a40;border-radius:8px;text-align:center}.download .eyebrow{color:var(--rose-surface)}.download h2{font-size:32px;margin:0 auto 15px;text-align:center}.download p:not(.eyebrow){max-width:660px;margin:0 auto 24px}.file-note{font-size:13px;color:var(--ink);margin:15px auto 0!important}.mail-note{margin:26px 0;padding:18px 22px;border-left:3px solid var(--accent);background:#fff8;font-size:14px}.further{margin-top:30px}
@media(max-width:720px){.resource-hero{min-height:410px;padding:125px 0 55px}.source-copy h2,.download h2{font-size:27px}.orbit{right:-250px}}
</style>
