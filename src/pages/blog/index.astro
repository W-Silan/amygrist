---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {getArticles} from '../../data/articles';
import {categories as categoryArchives} from '../../data/categories';

const articles = await getArticles();
---
<BaseLayout title="Blog | Amy Grist" description="Articles by Amy Grist on Inner Child healing, reparenting, emotional wellbeing, mindfulness and personal growth." solidHeader={true}>
  <section class="blog-archive container" aria-labelledby="blog-title">
    <header class="blog-heading">
      <p class="eyebrow">Ideas for reflection and wellbeing</p>
      <h1 id="blog-title">Articles</h1>
      <p>Explore writing on Inner Child work, mindfulness, relationships and holistic wellbeing.</p>
    </header>
    <nav class="category-links" aria-label="Browse article categories">{categoryArchives.map((category) => <a href={category.path}>{category.name}</a>)}</nav>
    <div class="blog-controls">
      <label class="sr-only" for="category-select">Browse categories</label>
      <select id="category-select">
        <option value="/blog/">All articles</option>
        {categoryArchives.map((category) => <option value={category.path}>{category.name}</option>)}
      </select>
    </div>
    <div class="article-grid">
      {articles.map((article) => <div class="article-grid__item" data-categories={JSON.stringify(article.categories)}><ArticleCard {article} /></div>)}
    </div>
    <p class="empty-status" hidden>No articles were found in this topic.</p>
  </section>
</BaseLayout>
<script>
  const categorySelect = document.querySelector<HTMLSelectElement>('#category-select');
  categorySelect?.addEventListener('change', () => {
    if (categorySelect.value) window.location.assign(categorySelect.value);
  });
</script>
<style>
.blog-archive{padding-top:clamp(150px,16vw,190px);padding-bottom:90px}.blog-heading{max-width:800px;margin:0 auto 46px;text-align:center}.blog-heading .eyebrow{font:400 14px var(--nav);letter-spacing:.12em;text-transform:uppercase;color:var(--teal);margin:0 0 13px}.blog-heading h1{color:var(--ink);font-size:clamp(42px,6vw,64px);margin:0 0 14px}.blog-heading>p:last-child{font-size:18px}.category-links{display:flex;flex-wrap:wrap;justify-content:center;gap:9px;margin:0 auto 32px;max-width:1000px}.category-links a{display:inline-flex;align-items:center;border:1px solid #023c4d40;border-radius:99px;padding:8px 13px;color:var(--teal);font:400 13px/1.3 var(--nav);text-decoration:none}.category-links a:hover,.category-links a:focus-visible{background:var(--teal);color:white}.blog-controls{display:none;align-items:center;gap:14px;margin:0 0 28px;color:var(--ink)}.blog-controls label{font-weight:500}.blog-controls select{font:inherit;color:var(--ink);background:white;border:1px solid #023c4d55;border-radius:4px;padding:9px 34px 9px 12px;max-width:100%}.filter-status{margin:0 0 0 auto;font-size:14px}.article-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.article-grid__item[hidden]{display:none}.empty-status{text-align:center;padding:40px;color:var(--ink)}@media(max-width:1050px){.article-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}}@media(max-width:999px){.category-links{display:none}.blog-controls{display:block}.blog-controls select{display:block;width:100%;max-width:none}}@media(max-width:680px){.blog-archive{padding-top:130px;padding-bottom:60px}.blog-heading{margin-bottom:34px}.article-grid{grid-template-columns:1fr;gap:18px}}
</style>
