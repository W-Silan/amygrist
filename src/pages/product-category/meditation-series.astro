---
import {Image} from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {products} from '../../data/products';

const series = products.find((product) => product.slug === 'gma_complete_series')!;
const individual = products.filter((product) => product.slug !== 'gma_complete_series');
---
<BaseLayout title="Meditation Series | Amy Grist" description="Browse Amy Grist’s guided meditation audio series for relaxation, balance and wellbeing." solidHeader={true}>
  <section class="category-page container" aria-labelledby="category-title">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/shop/">Shop</a><span aria-hidden="true">›</span><span>Meditation Series</span></nav>
    <header class="category-heading"><p class="eyebrow">Digital resources · Meditation</p><h1 id="category-title">Meditation Series</h1><p>Guided audio practices to support relaxation, calm and a deeper connection with your inner world.</p></header>
    <section aria-labelledby="complete-title">
      <article class="complete-card">
        <a class="complete-image" href={`/shop/${series.slug}/`}><Image src={series.image} alt={series.imageAlt} widths={[420,640,960]} sizes="(max-width: 700px) 88vw, 38vw" format="webp" loading="eager"/></a>
        <div class="complete-copy"><p class="eyebrow">Complete collection</p><h2 id="complete-title"><a href={`/shop/${series.slug}/`}>Inner Harmony &amp; Balance Meditation Series</a></h2><p>{series.summary}</p><p class="price">{series.price}</p><a class="button" href={`/shop/${series.slug}/`}>View the complete collection <span aria-hidden="true">→</span></a></div>
      </article>
    </section>
    <section class="individual-section" aria-labelledby="individual-title"><header><p class="eyebrow">Choose a single practice</p><h2 id="individual-title">Individual Meditations</h2></header>
      <div class="product-grid">{individual.map(product => <article class="product-card"><a class="product-image" href={`/shop/${product.slug}/`}><Image src={product.image} alt={product.imageAlt} widths={[360,540,720]} sizes="(max-width: 700px) 88vw, (max-width: 1000px) 43vw, 30vw" format="webp" loading="lazy"/></a><div class="product-copy"><h3><a href={`/shop/${product.slug}/`}>{product.shortName}</a></h3><p>{product.summary}</p><p class="product-meta">Guided audio · {product.duration} · {product.price}</p><a class="text-link" href={`/shop/${product.slug}/`}>View meditation <span aria-hidden="true">→</span></a></div></article>)}</div>
    </section>
    <p class="shop-back"><a href="/shop/">← Back to the shop</a></p>
  </section>
</BaseLayout>
<style>
.category-page{padding-top:clamp(150px,16vw,190px);padding-bottom:90px}.breadcrumbs{display:flex;gap:10px;margin:0 0 35px;font-size:14px;color:var(--ink)}.breadcrumbs a,.shop-back a,.text-link{color:var(--link);}.category-heading{max-width:850px;margin:0 auto 46px;text-align:center}.eyebrow{font:400 14px var(--nav);letter-spacing:.12em;text-transform:uppercase;color:var(--rose-surface);margin:0 0 12px}.category-heading h1{font-size:clamp(40px,6vw,62px);color:var(--ink);margin:0 0 16px}.category-heading>p:last-child{font-size:18px}.complete-card{display:grid;grid-template-columns:minmax(260px,.85fr) minmax(0,1.15fr);gap:clamp(28px,5vw,64px);align-items:center;max-width:1100px;margin:auto;padding:clamp(22px,4vw,42px);border:1px solid #023c4d20;border-radius:8px;background:white;box-shadow:0 12px 30px #023c4d0d}.complete-image,.product-image{display:block;overflow:hidden;border-radius:5px;background:var(--soft-rose)}.complete-image img,.product-image img{width:100%;aspect-ratio:1;object-fit:cover;transition:transform .3s ease}.complete-image:hover img,.product-image:hover img{transform:scale(1.02)}.complete-copy h2{font-size:clamp(28px,3.5vw,40px);margin:0 0 16px}.complete-copy h2 a,.product-copy h3 a{color:var(--ink);text-decoration:none}.complete-copy>p:not(.eyebrow){line-height:1.7}.price{font-size:24px;color:var(--link);font-weight:500;margin:20px 0}.button{display:inline-flex}.button:hover{text-decoration:none}.individual-section{max-width:1100px;margin:76px auto 0}.individual-section>header{text-align:center;margin-bottom:32px}.individual-section h2{font-size:clamp(32px,4vw,44px);margin:0;color:var(--ink)}.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.product-card{display:grid;grid-template-columns:minmax(140px,.78fr) minmax(0,1.22fr);gap:22px;align-items:center;padding:20px;border:1px solid #023c4d20;border-radius:8px;background:white;box-shadow:0 8px 22px #023c4d0a}.product-copy h3{font-size:24px;margin:0 0 10px}.product-copy>p{font-size:15px;line-height:1.55;margin:0 0 12px}.product-copy .product-meta{font-size:14px;color:var(--link);font-weight:500;margin-bottom:10px}.text-link{font-size:14px}.shop-back{margin:38px 0 0}@media(max-width:900px){.product-card{grid-template-columns:1fr;align-items:start}.product-image img{aspect-ratio:1.2}.product-copy h3{font-size:22px}}@media(max-width:700px){.category-page{padding-top:130px;padding-bottom:60px}.category-heading{margin-bottom:32px}.complete-card{grid-template-columns:1fr;padding:18px;gap:22px}.complete-copy h2{font-size:30px}.individual-section{margin-top:54px}.product-grid{grid-template-columns:1fr;gap:20px}.product-card{grid-template-columns:minmax(110px,.7fr) minmax(0,1.3fr);gap:16px;padding:14px}.product-image img{aspect-ratio:1}.product-copy h3{font-size:20px}.product-copy>p{font-size:14px}}
</style>
