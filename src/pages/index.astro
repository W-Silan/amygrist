---
import {Image} from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Copy from '../components/Copy.astro';
import Testimonials from '../components/Testimonials.astro';
import home from '../data/home.json';
import {images} from '../data/images';
const products=[{id:1150 as const,name:'Complete Series',price:'35.95',url:'/shop/gma_complete_series/'},{id:1157 as const,name:'Higher Wisdom',price:'4.99',url:'https://amygrist.com/product/gma_higher_wisdom/'},{id:1156 as const,name:'The Inner Child',price:'4.99',url:'https://amygrist.com/product/gma_the_inner_child/'}];
---
<BaseLayout title="Amy Grist | Trauma-Informed | Inner Child Work" description="Trauma-informed holistic healing with Amy. Inner Child work, mindset and wellbeing coaching, meditation, Reiki, mentoring and practitioner training.">
 <Hero/>
 <section class="band rose welcome center"><div class="container"><h1>{home[1].headings[0]}</h1><h2 set:html={home[1].headings[1]}/><h3>{home[1].headings[2]}</h3><hr class="rule short"/><blockquote><Copy texts={home[1].texts}/></blockquote><a class="button" href={home[1].buttons[0].url}>{home[1].buttons[0].text} ♡</a></div></section>
 <section class="band center introduction"><div class="container"><h3>{home[2].headings[0]}</h3><hr class="rule short"/><Copy texts={home[2].texts}/><div class="heart" aria-hidden="true">♡</div></div></section>
 <section class="start"><div class="container"><hr class="rule"/><h3>{home[3].headings[0]}</h3><Copy texts={home[3].texts}/></div></section>
 <section class="band deep-teal workshop"><div class="container"><h2>{home[4].headings[0]}</h2><hr class="rule"/><div class="two-column"><Image class="rounded" src={images[1133]} alt="Amy holding an online Inner Child workshop" widths={[480,768,1000]} sizes="(max-width: 999px) 88vw, 36vw" format="webp"/><Copy texts={home[4].texts}/></div><hr class="rule"/><div class="two-column workshop-cta"><Copy texts={home[5].texts}/><div class="center"><a class="button" href={home[5].buttons[0].url.replace('http:','https:')}>{home[5].buttons[0].text}</a></div></div></div></section>
 <Testimonials/>
 <section class="about-pair soft-rose"><div><h2>{home[7].headings[0]}</h2><hr class="rule"/><Copy texts={[home[7].texts[0]]}/></div><div><h2>{home[7].headings[1]}</h2><hr class="rule"/><Copy texts={[home[7].texts[1]]}/></div></section>
 <section class="band deep-teal"><div class="container"><div class="coaching"><Image class="rounded" src={images[1130]} alt="Amy Grist smiling outdoors" widths={[400,600,1000]} sizes="(max-width:999px) 88vw, 24vw" format="webp"/><div><h2 set:html={home[8].headings[0]}/><hr class="rule"/><Copy texts={[home[8].texts[0]]}/><a class="button" href={home[8].buttons[0].url}>{home[8].buttons[0].text}</a></div></div><div class="mentoring"><h2>{home[8].headings[1]}</h2><hr class="rule"/><Copy texts={home[8].texts.slice(1)}/><hr class="rule short"/></div></div></section>
 <section class="band center invitation"><div class="container"><h4>{home[9].headings[0]}</h4><Copy texts={home[9].texts}/></div></section>
 <section class="band soft-rose"><div class="container meditation"><Image src={images[419]} alt="Cultivating Sacred Inner Space meditation course booklet" widths={[240,480,671]} sizes="(max-width:999px) 240px, 16vw" format="webp"/><div><h2>{home[10].headings[0]}</h2><Copy texts={home[10].texts}/><a class="button" href="https://amygrist.com/meditation/">Get Your Free Mini-Course →</a></div></div></section>
 <section class="band"><div class="container featured"><div><h2 class="center">{home[11].headings[0]}</h2><Copy texts={home[11].texts}/><div class="center"><a class="button" href={home[11].buttons[0].url}>{home[11].buttons[0].text}</a></div></div><Image src={images[259]} alt="Amy in conversation with a psychologist" widths={[400,640,1000]} sizes="(max-width:999px) 88vw, 24vw" format="webp"/></div></section>
 <section class="resources"><div class="container"><hr class="rule"/><h2>{home[13].headings[0]}</h2><div class="product-grid">{products.map(p=><a class="product" href={p.url}><Image src={images[p.id]} alt={`Inner Harmony & Balance Meditation Series: ${p.name}`} widths={[400,600,900]} sizes="(max-width:600px) 88vw, 24vw" format="webp"/><h3>Guided Meditation Audio MP3 | {p.name.toUpperCase()} | Instant Digital Download</h3><p>£{p.price}</p></a>)}</div><div class="center"><a class="button" href={home[13].buttons[0].url}>{home[13].buttons[0].text}</a></div></div></section>
 <section class="band"><div class="container"><Copy texts={home[14].texts}/></div></section>
</BaseLayout>
<style>
.welcome{padding:50px 0 40px}.welcome h2{font-size:35px}.welcome h3{font-size:40px}.welcome blockquote{max-width:820px;margin:30px auto 50px}.welcome .rule{border-color:var(--soft-rose)}.introduction{padding-bottom:0}.introduction .rule{border-color:var(--soft-rose);width:300px}.heart{color:var(--accent);font-size:48px;margin:20px 0}.start{padding:0 0 55px}.start .rule{border-color:var(--text-rose);margin-bottom:45px}.two-column{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center}.rounded{border-radius:10px}.workshop-cta{padding-top:30px}.about-pair{display:grid;grid-template-columns:1fr 1fr}.about-pair>div{padding:80px 10%}.about-pair>div+div{background:#bc5f6a33}.about-pair .rule{border-color:var(--text-rose)}.about-pair a{color:inherit}.coaching{display:grid;grid-template-columns:1fr 2fr;gap:60px;align-items:start}.coaching .button{margin-top:30px}.mentoring{padding:75px 3% 0}.mentoring .rule.short{margin:25px auto}.invitation :global(ul){display:table;text-align:left;margin:0 auto 35px}.invitation :global(h5){margin:0}.meditation{display:grid;grid-template-columns:240px 1fr;gap:90px;align-items:center}.meditation .button{margin-top:24px}.featured{display:grid;grid-template-columns:2fr 1fr;gap:30px;align-items:center}.featured .button{margin-top:30px}.resources .rule{border-color:var(--text-rose);margin:0 0 50px}.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin:50px 0}.product{color:var(--text-rose);text-align:center}.product h3{font-size:23px;margin:20px 0 8px}.product img{width:100%;aspect-ratio:1;object-fit:cover}
@media(max-width:999px){.welcome h2{font-size:30px}.welcome h3{font-size:26px}.welcome blockquote{margin:45px 0}.two-column,.about-pair,.coaching,.meditation,.featured{grid-template-columns:1fr;gap:30px}.about-pair>div{padding:45px 6%}.coaching{gap:35px}.coaching img{width:100%;max-height:650px;object-fit:cover}.mentoring{padding:60px 0 0}.meditation img{width:240px;margin:auto}.workshop-cta{gap:24px}.product-grid{gap:20px}.featured img{margin-top:15px}.start{padding-bottom:45px}}
@media(max-width:600px){.product-grid{grid-template-columns:1fr}.welcome h1{font-size:40px}.welcome h2{font-size:30px}.welcome h3{font-size:25px}.welcome .button{font-size:12px}.coaching img{max-height:none}}
</style>
